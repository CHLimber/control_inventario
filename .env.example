# Copiar a .env y completar. .env NUNCA se sube a git.

# API de Claude (solo la usa el asistente RAG)
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-haiku-5-5

# Roboflow (solo para descargar datasets; cuenta gratuita)
ROBOFLOW_API_KEY=

# Visión
# VARIANTE_VISION: mock (conteos falsos), A (detector + clasificador CNN) o B (YOLO multiclase)
VARIANTE_VISION=mock
# Confianza mínima del detector para aceptar una caja
UMBRAL_DET=0.25
# Confianza mínima del clasificador; por debajo la caja es "desconocido"
UMBRAL_CONF=0.5

# Base de datos (SQLite local; para MySQL basta cambiar la URL)
URL_BD=sqlite:///datos/inventario.db

# Servidor
PUERTO=8000
